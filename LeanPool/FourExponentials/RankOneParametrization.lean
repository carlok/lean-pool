/-!
# A rank-one matrix of logarithms

Let $l_{11},l_{12},l_{21},l_{22}$ be non-zero complex numbers with every $e^{l_{ij}}$ algebraic,
$l_{11}l_{22}=l_{12}l_{21}$ and
$\operatorname{trdeg}_{\mathbb{Q}}\mathbb{Q}[l_{11},l_{12},l_{21},l_{22}] \le1$, and suppose that
neither the rows nor the columns of $(l_{ij})$ are linearly dependent over $\mathbb{Q}$. Then there
are $x_1,x_2,y_1,y_2\in\mathbb{C}$, with $x_1,x_2$ linearly independent over $\mathbb{Q}$ and
likewise $y_1,y_2$, such that every $e^{x_iy_j}$ is algebraic and
$\operatorname{trdeg}_{\mathbb{Q}}\mathbb{Q}[x_1,x_2,y_1,y_2] \le1$.

Source: Elementary; as in [Wal73, § I].

## References

* [Wal73] M. Waldschmidt, *Solution du huitième problème de Schneider*, J. Number Theory 5 (1973),
  191–202.

From `Diaz/Mirror/rank_one_parametrization.lean` of
[diaz-modulus-lean](https://github.com/carlok/diaz-modulus-lean) at `465147a`, where it mirrors the
proof accepted on Prove2Me as `FourExp.rank_one_parametrization`.
-/

@[expose] public section

namespace FourExponentials

namespace FourExpRank

/-- If everything in `T` is algebraic over a subalgebra `B` of transcendence degree at most one,
then so is the algebra generated by `T`. -/
lemma trdeg_adjoin_tower (B : Subalgebra ℚ ℂ) (T : Set ℂ) (hB : Algebra.trdeg ℚ ↥B ≤ 1)
    (halg : ∀ x ∈ T, IsAlgebraic ↥B x) :
    Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ T) ≤ 1 := by
  -- stated once, so that instance search does not have to rediscover them
  have : FaithfulSMul ℚ ↥B :=
    (faithfulSMul_iff_algebraMap_injective ℚ ↥B).2 (algebraMap ℚ ↥B).injective
  have : FaithfulSMul ↥B ↥(Algebra.adjoin ↥B T) :=
    (faithfulSMul_iff_algebraMap_injective _ _).2 fun x y h => by
      have h' : (algebraMap ↥B ↥(Algebra.adjoin ↥B T) x : ℂ) =
          (algebraMap ↥B ↥(Algebra.adjoin ↥B T) y : ℂ) := congrArg Subtype.val h
      exact Subtype.ext h'
  have hCalg : Algebra.IsAlgebraic ↥B ↥(Algebra.adjoin ↥B T) := by
    rw [← Subalgebra.isAlgebraic_iff, Algebra.isAlgebraic_adjoin_iff]
    exact halg
  have hsum : Algebra.trdeg ℚ ↥B + Algebra.trdeg ↥B ↥(Algebra.adjoin ↥B T)
      = Algebra.trdeg ℚ ↥(Algebra.adjoin ↥B T) := trdeg_add_eq ℚ ↥B
  rw [show Algebra.trdeg ↥B ↥(Algebra.adjoin ↥B T) = 0 from trdeg_eq_zero, add_zero] at hsum
  have hle : Algebra.adjoin ℚ T ≤ (Algebra.adjoin ↥B T).restrictScalars ℚ :=
    Algebra.adjoin_le fun x hx => Algebra.subset_adjoin hx
  refine (trdeg_le_of_injective (Subalgebra.inclusion hle)
    (Subalgebra.inclusion_injective hle)).trans ?_
  change Algebra.trdeg ℚ ↥(Algebra.adjoin ↥B T) ≤ 1
  rw [← hsum]
  exact hB

end FourExpRank

/-- **A rank-one matrix of logarithms.** Let $l_{11},l_{12},l_{21},l_{22}$ be non-zero complex
numbers with every $e^{l_{ij}}$ algebraic, $l_{11}l_{22}=l_{12}l_{21}$ and
$\operatorname{trdeg}_{\mathbb{Q}}\mathbb{Q}[l_{11},l_{12},l_{21},l_{22}] \le1$, and suppose that
neither the rows nor the columns of $(l_{ij})$ are linearly dependent over $\mathbb{Q}$. Then there
are $x_1,x_2,y_1,y_2\in\mathbb{C}$, with $x_1,x_2$ linearly independent over $\mathbb{Q}$ and
likewise $y_1,y_2$, such that every $e^{x_iy_j}$ is algebraic and
$\operatorname{trdeg}_{\mathbb{Q}}\mathbb{Q}[x_1,x_2,y_1,y_2] \le1$. -/
theorem rank_one_parametrization :
    ∀ l₁₁ l₁₂ l₂₁ l₂₂ : ℂ,
      IsAlgebraic ℚ (Complex.exp l₁₁) → IsAlgebraic ℚ (Complex.exp l₁₂) →
      IsAlgebraic ℚ (Complex.exp l₂₁) → IsAlgebraic ℚ (Complex.exp l₂₂) →
      l₁₁ ≠ 0 → l₁₂ ≠ 0 → l₂₁ ≠ 0 → l₂₂ ≠ 0 →
      l₁₁ * l₂₂ = l₁₂ * l₂₁ →
      Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)) ≤ 1 →
      ¬ (∃ a b : ℚ, ¬(a = 0 ∧ b = 0) ∧
          (a : ℂ) * l₁₁ + (b : ℂ) * l₂₁ = 0 ∧ (a : ℂ) * l₁₂ + (b : ℂ) * l₂₂ = 0) →
      ¬ (∃ a b : ℚ, ¬(a = 0 ∧ b = 0) ∧
          (a : ℂ) * l₁₁ + (b : ℂ) * l₁₂ = 0 ∧ (a : ℂ) * l₂₁ + (b : ℂ) * l₂₂ = 0) →
      ∃ x₁ x₂ y₁ y₂ : ℂ, LinearIndependent ℚ ![x₁, x₂] ∧ LinearIndependent ℚ ![y₁, y₂] ∧
        (∀ i j : Fin 2, IsAlgebraic ℚ (Complex.exp (![x₁, x₂] i * ![y₁, y₂] j))) ∧
        Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({x₁, x₂, y₁, y₂} : Set ℂ)) ≤ 1 := by
  intro l₁₁ l₁₂ l₂₁ l₂₂ he11 he12 he21 he22 h11 h12 h21 h22 hrank htr hcols hrows
  have ht12 : l₁₁ * (l₁₂ / l₁₁) = l₁₂ := by field_simp
  have ht22 : l₂₁ * (l₁₂ / l₁₁) = l₂₂ := by
    field_simp
    linear_combination -hrank
  refine ⟨l₁₁, l₂₁, 1, l₁₂ / l₁₁, ?_, ?_, ?_, ?_⟩
  · -- the first pair is independent over `ℚ`
    rw [LinearIndependent.pair_iff]
    intro a b hab
    by_contra hne
    refine hcols ⟨a, b, hne, ?_, ?_⟩
    · simpa [Rat.smul_def] using hab
    · have h : (a : ℂ) * l₁₁ + (b : ℂ) * l₂₁ = 0 := by simpa [Rat.smul_def] using hab
      have key : (a : ℂ) * l₁₂ + (b : ℂ) * l₂₂ = (l₁₂ / l₁₁) * ((a : ℂ) * l₁₁ + (b : ℂ) * l₂₁) := by
        field_simp
        linear_combination (b : ℂ) * hrank
      rw [key, h, mul_zero]
  · -- the second pair is independent over `ℚ`
    rw [LinearIndependent.pair_iff]
    intro a b hab
    simp only [Rat.smul_def, mul_one] at hab
    by_cases hb : b = 0
    · refine ⟨?_, hb⟩
      rw [hb] at hab
      simpa using hab
    · exfalso
      have hbc : (b : ℂ) ≠ 0 := by exact_mod_cast hb
      have hab' : (a : ℂ) * l₁₁ + (b : ℂ) * l₁₂ = 0 := by
        have key : (a : ℂ) * l₁₁ + (b : ℂ) * l₁₂ = ((a : ℂ) + (b : ℂ) * (l₁₂ / l₁₁)) * l₁₁ := by
          field_simp
        rw [key, hab, zero_mul]
      have hab'' : (a : ℂ) * l₂₁ + (b : ℂ) * l₂₂ = 0 := by
        have key : (a : ℂ) * l₂₁ + (b : ℂ) * l₂₂ = (l₂₁ / l₁₁) * ((a : ℂ) * l₁₁ + (b : ℂ) * l₁₂) :=
            by
          field_simp
          linear_combination (b : ℂ) * hrank
        rw [key, hab', mul_zero]
      exact hrows ⟨a, b, fun hzero => hb hzero.2, hab', hab''⟩
  · -- the four exponentials
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp only [Nat.succ_eq_add_one, Nat.reduceAdd, Fin.zero_eta, Fin.isValue,
        Matrix.cons_val_zero, Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_fin_one, mul_one,
        ht12, ht22]
    · exact he11
    · exact he12
    · exact he21
    · exact he22
  · -- transcendence degree
    have htalg : IsAlgebraic ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)) (l₁₂ / l₁₁) := by
      refine ⟨Polynomial.C ⟨l₁₁, Algebra.subset_adjoin (by simp)⟩ * Polynomial.X
        - Polynomial.C ⟨l₁₂, Algebra.subset_adjoin (by simp)⟩, ?_, ?_⟩
      · intro hzero
        have hc := congrArg (fun p => AddMonoidAlgebra.coeff p 1) hzero
        simp only [AddMonoidAlgebra.coeff_sub, Finsupp.coe_sub, Pi.sub_apply,
          Polynomial.coeff_mul_X, Polynomial.coeff_C, ↓reduceIte,
          AddMonoidAlgebra.coeff_zero, Finsupp.coe_zero, Pi.zero_apply] at hc
        exact h11 (by simpa using congrArg Subtype.val hc)
      · simp [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_mul, ht12]
    refine FourExpRank.trdeg_adjoin_tower (Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)) _ htr ?_
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with h | h | h | h <;> rw [h]
    · exact isAlgebraic_algebraMap (⟨l₁₁, Algebra.subset_adjoin (by simp)⟩ :
        ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)))
    · exact isAlgebraic_algebraMap (⟨l₂₁, Algebra.subset_adjoin (by simp)⟩ :
        ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)))
    · exact isAlgebraic_one
    · exact htalg

end FourExponentials
